{
  "name": "Cadence iOS · Editorial Instrument",
  "color": {
    "light": { "bg": "#F4F1EA", "surface": "#FFFFFF", "ink": "#111111", "ink2": "#6B6860", "rule": "#DAD6CC", "signal": "#E84A2A", "signalSoft": "#FBE3DC" },
    "dark":  { "bg": "#0A0A0A", "surface": "#161616", "ink": "#F4F1EA", "ink2": "#9A978F", "rule": "#2A2A2A", "signal": "#E84A2A", "signalSoft": "#3A1A12" }
  },
  "type": {
    "display":   { "family": "Instrument Serif", "fallback": "New York", "sizes": { "hero": 44, "screenTitle": 34, "prompt": 28, "grade": 24, "cardPrompt": 20 }, "lineHeight": 1.05, "tracking": -0.01 },
    "body":      { "family": "SF Pro Text", "size": 17, "lineHeight": 1.45, "tracking": -0.2 },
    "secondary": { "family": "SF Pro Text", "size": 15, "color": "ink2" },
    "micro":     { "family": "SF Pro Text", "size": 11, "weight": 500, "uppercase": true, "tracking": 0.08, "color": "ink2" },
    "numeral":   { "family": "SF Pro Display", "weight": 500, "tabular": true, "tracking": -0.03, "sizes": { "score": 96, "countdown": 64, "stat": 24, "listScore": 20 } },
    "mono":      { "family": "SF Mono", "size": 12, "color": "ink2" }
  },
  "space": { "gutter": 20, "xs": 4, "s": 8, "m": 12, "l": 16, "xl": 24, "xxl": 40 },
  "radius": { "button": 0, "card": 12, "record": 999 },
  "stroke": { "hairline": 1 },
  "size": { "primaryButtonHeight": 56, "recordButton": 72, "tabBarHeight": 49 },
  "motion": { "sessionCrossfadeMs": 300, "scoreCountUpMs": 1100, "fillerFlashMs": 120 }
}
